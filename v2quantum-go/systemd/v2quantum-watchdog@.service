[Unit]
Description=V2Quantum health watchdog (%i)
After=v2quantum@%i.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/v2quantum/%i.env
ExecStart=/usr/local/libexec/v2quantum-watchdog %i
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
