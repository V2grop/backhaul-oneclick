{
  "version": 1,
  "role": "client",
  "node_name": "outside-raw",
  "carrier": {
    "mode": "raw_icmp",
    "pool": 1,
    "keepalive_seconds": 10,
    "dial_timeout_seconds": 8,
    "reconnect_min_millis": 500,
    "reconnect_max_millis": 15000,
    "max_streams_per_session": 256,
    "raw": {
      "local_ip": "198.51.100.20",
      "peer_ip": "192.0.2.10",
      "expected_peer_source_ip": "192.0.2.10",
      "interface": "eth0",
      "icmp_identifier": 22066,
      "payload_mtu": 1200,
      "experimental_enabled": true,
      "allow_unrouted_spoof": false
    }
  },
  "security": {
    "psk_env": "V2QUANTUM_PSK"
  },
  "mappings": [
    {
      "name": "vless",
      "protocol": "tcp",
      "target": "127.0.0.1:2444"
    }
  ],
  "health": {
    "listen": "127.0.0.1:9090",
    "allow_public_listen": false
  },
  "logging": {
    "level": "info",
    "json": false
  }
}
