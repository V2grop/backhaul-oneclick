{
  "version": 1,
  "role": "server",
  "node_name": "iran",
  "carrier": {
    "mode": "quantum_udp",
    "listen": "0.0.0.0:8880",
    "pool": 4,
    "keepalive_seconds": 10,
    "dial_timeout_seconds": 8,
    "reconnect_min_millis": 500,
    "reconnect_max_millis": 15000,
    "max_streams_per_session": 512,
    "quantum": {
      "profile": "balanced",
      "auto_tune": true
    }
  },
  "security": {
    "psk_env": "V2QUANTUM_PSK"
  },
  "mappings": [
    {
      "name": "vless",
      "protocol": "tcp",
      "listen": "0.0.0.0:2444"
    }
  ],
  "health": {
    "listen": "127.0.0.1:9090",
    "allow_public_listen": false
  },
  "logging": {
    "level": "info",
    "json": false
  }
}
